<div class="index-container">
  <section class="index-hero">
    <div class="index-hero-copy">
      <p class="index-kicker">MEHAEI / NOTES</p>
      <h1>把技术，写得清楚一点。</h1>
      <p>持续记录编程、工程实践与生活里的有趣问题。</p>
      <div class="index-hero-topics"><span>Python</span><span>Engineering</span><span>AI</span></div>
    </div>
    <div class="index-hero-art" aria-hidden="true">
      <div class="hero-code-card">
        <div class="hero-code-bar"><i></i><i></i><i></i><span>~/mehaei</span></div>
        <code><b>$</b> build --idea clarity</code>
        <strong>Ideas become systems.</strong>
      </div>
      <div class="hero-stat-card"><b><%= site.posts.length %></b><span>篇技术笔记</span></div>
    </div>
  </section>
  
  <!-- 文章列表 -->
  <div class="post-list">
    <% page.posts.each(function(post) { %>
      <%- partial('_partial/post-item', {post: post}) %>
    <% }) %>
  </div>
  
  <!-- 分页 -->
  <%- partial('_partial/pagination') %>
</div>
